.bind-content{padding:60rpx 66rpx 50rpx;text-align:center}.shield{width:100rpx;height:100rpx;border:2rpx solid #85bec0;border-radius:50%;margin:0 auto 36rpx;background:#dff1f0;display:flex;align-items:center;justify-content:center}.shield view{width:42rpx;height:48rpx;border:3rpx solid var(--color-primary);border-radius:4rpx 4rpx 18rpx 18rpx;line-height:44rpx;font-size:30rpx}.eyebrow{font-size:16rpx;letter-spacing:4rpx;color:#559799;margin-bottom:16rpx}.heading{font-size:42rpx;font-weight:700;margin-bottom:28rpx}.intro{font-size:26rpx;line-height:1.9;color:#548d8f;margin-bottom:44rpx}.avatar-picker{display:flex;align-items:center;gap:24rpx;background:transparent;color:#558d8d;font-size:24rpx;text-align:left;margin-bottom:32rpx;min-height:88rpx}.avatar-picker image,.avatar-placeholder{width:76rpx;height:76rpx;border-radius:50%;background:#e5f4f3}.avatar-placeholder{line-height:76rpx;text-align:center;font-size:42rpx;color:#7aa9a8}.field-label{display:block;font-size:24rpx;color:#367d7e;text-align:left;margin-bottom:30rpx}.field-label input{background:#e5f4f3;border:2rpx solid #a0c9c8;border-radius:12rpx;font-size:28rpx;padding:24rpx;margin-top:16rpx;height:92rpx}.consent{display:flex;gap:12rpx;text-align:left;font-size:22rpx;line-height:1.9;margin-bottom:32rpx;min-height:88rpx;align-items:flex-start}.consent checkbox{transform:scale(.75);transform-origin:left top;width:38rpx;margin-top:4rpx;flex-shrink:0}.privacy-link{color:var(--color-text);font-weight:600}.note{font-size:20rpx;color:#639596;line-height:1.8;margin-top:26rpx}.privacy-overlay{position:fixed;inset:0;background:#153b4866;z-index:99;display:flex;align-items:center;padding:50rpx}.privacy-box{background:#f5fbfa;border-radius:24rpx;padding:44rpx;width:100%}.privacy-title{font-size:34rpx;font-weight:600;margin-bottom:24rpx}.privacy-text{font-size:26rpx;line-height:1.8;color:#4b797b}.contract-link{background:none;font-size:26rpx;color:var(--color-text);margin:24rpx 0 36rpx;text-decoration:underline;min-height:88rpx}.cancel{background:none;font-size:26rpx;color:#729392;margin-top:26rpx;min-height:80rpx}
