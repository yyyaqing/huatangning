.survey-content{padding:65rpx 66rpx 0}.question{margin-bottom:58rpx}.question-title{font-size:32rpx;font-weight:750;line-height:1.27;margin-bottom:28rpx;letter-spacing:-.8rpx}.question-hint{font-size:20rpx;font-weight:400;letter-spacing:0;white-space:nowrap}.option{position:relative;display:flex;align-items:flex-start;gap:24rpx;font-size:27.5rpx;font-weight:400;line-height:1.48;min-height:88rpx;padding-top:4rpx;padding-bottom:8rpx}.native-control{position:absolute;inset:0;opacity:0;width:100%;height:100%}.radio-visual{width:22rpx;height:22rpx;border:2rpx solid var(--color-primary);border-radius:50%;margin-top:8rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.radio-visual>view{width:10rpx;height:10rpx;border:2rpx solid var(--color-primary);border-radius:50%}.radio-visual.square,.radio-visual.square>view{border-radius:3rpx}.selected .radio-visual{background:var(--color-primary);box-shadow:inset 0 0 0 4rpx #cde7ea}.selected .option-text{font-weight:600}.option-text{flex:1;pointer-events:none}.question textarea{width:100%;min-height:180rpx;background:#e4f3f2;border:2rpx solid #8eb9bc;padding:22rpx;font-size:28rpx;line-height:1.7;border-radius:12rpx;color:var(--color-text)}.question:last-of-type{margin-bottom:60rpx}.progress{font-size:18rpx;color:#497a80;text-align:center;margin:18rpx 0 26rpx}.custom-header image{width:750rpx;display:block}.custom-header>view{font-size:39rpx;font-weight:700;text-align:center;padding:75rpx 52rpx 30rpx;border-bottom:3rpx solid var(--color-primary)}
.phone-field input{width:100%;height:92rpx;min-height:44px;background:#e5f4f3;border:2rpx solid #8eb9bc;border-radius:12rpx;padding:20rpx;font-size:28rpx;color:var(--color-text)}.phone-field>view{font-size:20rpx;color:#497a80;line-height:1.7;margin-top:16rpx}
