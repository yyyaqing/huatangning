page{font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;background:#cde7ea;color:#18898b;--color-primary:#18898b;--color-text:#17656b;--color-surface:#cde7ea;--color-error:#9c343c;--color-soft:#e5f4f3}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;padding:0;line-height:1.4;border-radius:0}button::after{border:0}.brand-header,.science-footer{width:750rpx;display:block}.brand-header{height:244.44rpx}.science-footer{height:381.94rpx}.psd-button{width:100%;height:81rpx;min-height:44px;border-radius:50rpx;background:var(--color-primary);color:white;font-size:34rpx;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 8rpx 10rpx -6rpx #ffffff99,inset 0 -8rpx 10rpx -6rpx #00363a}.psd-button[disabled]{background:#77a9aa;color:#e7f3f3;opacity:.75}.pressed{opacity:.78}.error{font-size:26rpx;color:var(--color-error);background:#fff1f2;border:1rpx solid #e7b5ba;padding:20rpx 24rpx;border-radius:10rpx;line-height:1.6;margin-bottom:24rpx}.dev-notice{font-size:20rpx;color:#80652c;background:#fff3da;padding:14rpx;text-align:center}.loading{padding:120rpx 40rpx;text-align:center;color:var(--color-text);font-size:28rpx}.link{font-size:inherit;color:var(--color-text);background:transparent;display:inline;padding:0}.safe-bottom{padding-bottom:env(safe-area-inset-bottom)}
